    "PreToolUse": [
      {
        "matcher": "^(Read|Edit|Write|MultiEdit|read|read_file|edit|edit_file|write|write_file|patch|apply_patch|applypatch|multiedit|multi_edit|functions\\.apply_patch)$",
        "hooks": [
